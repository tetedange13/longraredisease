singularity {
  enabled = true
  autoMounts = true
  cacheDir = "/mnt/e/References/felix/singularity_img"
  pullTimeout = "1h"
}

executor {
  queueSize = 12
}

process {
  withName: MOSDEPTH_COV {
    // For MobiCNV: '--mapq 30' is used for short-read
    // Adapt to ONT R10 -> Q15
    ext.args = { "--no-per-base --mapq 15 --fast-mode" }
  }

  withName: SPECTRE_CNVCALLER {
    // Change min CNV length for Spectre
    // Default = 100K and have to be > 10K
    // WARN: Sample-id is required
    ext.args = { "--sample-id=${meta.id} --min-cnv-len 10001" }
  }

  withName: SNIFFLES_UNPHASED {
    // To avoid name overlap with '(phased_)sniffles.vcf' when bench
    ext.prefix = { "${meta.id}_sniffles_unphased" }
  }

  withName: '.*:CALL_SV:CUTESV' {
    // Versions >= v2.1 raise an 'contig not found error'...
    // Cannot update
    //container = 'quay.io/biocontainers/cutesv:2.1.2--pyhdfd78af_0'
    // Recommended for ONT on CuteSV's git:
    ext.args = {
      [
        '--sample=${meta.id}',
        '--genotype',
        '--report_readid',
        '--min_support=2',
        '--max_cluster_bias_INS 100 --diff_ratio_merging_INS 0.3 --max_cluster_bias_DEL 100 --diff_ratio_merging_DEL 0.3',
      ].join(' ')
    }
  }

  withName: '.*:CALL_SV:SNIFFLES' {
    // By default LRD uses Sniffles v2.4
    container = 'quay.io/biocontainers/sniffles:2.4--pyhdfd78af_0'
    // wfHvar use v2.6.3 (a modified version of it ?)
    //container = 'quay.io/biocontainers/sniffles:2.6.3--pyhdfd78af_0'
    // Latest to date is v2.8.1 but not available on Bioconda ??? -> Back to v2.8.0
    //container = 'quay.io/biocontainers/sniffles:2.8.0--pyhdfd78af_1'
  }

  withName: '.*:MERGE_SV:JASMINESV' {
    // Defaults:
    //ext.args = "min_support=2 --output_genotypes --keep_var_ids"
    ext.args = "min_support=1 --output_genotypes --keep_var_ids"
    // Ben's:
    //ext.args = "min_support=2 --allow_intrasample --normalize_type --output_genotypes"
  }

  withName: '.*:ANNOTSV_SNIFFLES' {
    time = '24h'
    // Use recent version of AnnotSV
    //container = 'https://depot.galaxyproject.org/singularity/annotsv:3.5.9--hdfd78af_0'
    container = 'quay.io/biocontainers/annotsv:3.5.9--hdfd78af_0'
  }
}
